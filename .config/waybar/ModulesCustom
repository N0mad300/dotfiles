{
  "custom/menu": {
    "format": "  ",
    "on-click": "pkill rofi || rofi -show drun",
    "on-click-middle": "$HOME/.config/hypr/scripts/wppicker.sh",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarLayout.sh",
    "tooltip-format": "Apps\nMiddle: wallpaper\nRight: Waybar layout"
  },

  "custom/file_manager": {
    "format": " ",
    "on-click": "nautilus",
    "tooltip-format": "Files"
  },

  "custom/tty": {
    "format": " ",
    "on-click": "kitty",
    "tooltip-format": "Terminal"
  },

  "custom/browser": {
    "format": " ",
    "on-click": "xdg-open https://",
    "tooltip-format": "Browser"
  },

  "custom/cycle_wall": {
    "format": " ",
    "on-click": "$HOME/.config/hypr/scripts/wppicker.sh",
    "on-click-right": "$HOME/.config/hypr/scripts/WaybarStyles.sh",
    "tooltip-format": "Wallpaper\nRight: Waybar style"
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "$HOME/.config/hypr/scripts/Wlogout.sh",
    "tooltip-format": "Power menu"
  },

  "custom/lock": {
    "format": "󰌾",
    "on-click": "$HOME/.config/hypr/scripts/power.sh lock",
    "tooltip-format": "Lock"
  },

  "custom/logout": {
    "format": "󰗼",
    "on-click": "$HOME/.config/hypr/scripts/power.sh logout",
    "tooltip-format": "Exit Hyprland"
  },

  "custom/quit": {
    "format": "󰗼",
    "on-click": "$HOME/.config/hypr/scripts/power.sh logout",
    "tooltip-format": "Exit Hyprland"
  },

  "custom/reboot": {
    "format": "󰜉",
    "on-click": "$HOME/.config/hypr/scripts/power.sh reboot",
    "tooltip-format": "Reboot"
  },

  "custom/swaync": {
    "format": "{} {icon} ",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip-format": "Notifications\nRight: do not disturb"
  },

  "custom/updater": {
    "format": " {}",
    "exec": "$HOME/.config/hypr/scripts/void-updates.sh",
    "interval": 3600,
    "on-click": "$HOME/.config/hypr/scripts/void-update.sh",
    "tooltip-format": "Void Linux updates"
  },

  "custom/separator#dot": {
    "format": "",
    "interval": "once",
    "tooltip": false
  },
  "custom/separator#dot-line": {
    "format": "",
    "interval": "once",
    "tooltip": false
  },
  "custom/separator#dot-blank": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/separator#line": {
    "format": "|",
    "interval": "once",
    "tooltip": false
  },
  "custom/separator#blank": {
    "format": "",
    "interval": "once",
    "tooltip": false
  }
}
